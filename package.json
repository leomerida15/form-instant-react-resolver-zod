        "zod"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/leomerida15/form-instant-react-resolver-zod.git"
    },
    "scripts": {
        "analyze": "size-limit --why",
        "build": "bun run bunpack.build.ts",
        "types": "bunx tsc --project tsconfig.declaration.json",
        "dev": "bun --watch ./src/index.ts",
        "lint": "eslint src --ext .ts,.tsx",
        "lint:fix": "eslint src --ext .ts,.tsx --fix",
        "test": "bun test",
        "test:coverage": "bun test --coverage",
        "test:watch": "bun test --watch",
        "up": "npm publish --access public",
        "up:rc": "npm publish --access public --tag rc",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@eslint/js": "^9.33.0",
        "@tsconfig/recommended": "^1.0.10",
        "@tsconfig/vite-react": "^3.4.0",
        "@types/bun": "^1.2.20",
        "@types/react": "^19.1.9",
        "@typescript-eslint/eslint-plugin": "^8.39.0",
        "@typescript-eslint/parser": "^8.39.0",
        "eslint": "^9.33.0",
        "eslint-plugin-prettier": "^5.5.4",
        "prettier": "^3.6.2",
        "typescript": "~5.0.4",
        "typescript-eslint": "^8.39.0",
        "zod": "^4.0.17"
    },
    "peerDependencies": {
        "@form-instant/react-input-mapping": "^1.8.0",
        "react": "^19",
        "react-dom": "^19"
    },
    "engines": {
        "node": ">=18",
        "bun": ">=1.0.0"
    },
    "files": [
        "dist"
    ]
}
