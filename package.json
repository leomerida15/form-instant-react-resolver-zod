{
    "name": "@form-instant/react-resolver-zod",
    "version": "1.8.4",
    "author": {
        "name": "leomerida15",
        "email": "dimasmerida15@gmail.com",
        "url": "https://github.com/leomerida15"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/leomerida15/form-instant-react-resolver-zod.git"
    },
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "analyze": "size-limit --why",
        "build": "bun run build.ts",
        "build:watch": "bun build ./src/index.ts --outdir ./dist --watch",
        "build:types": "tsc --declaration --emitDeclarationOnly --outDir ./dist",
        "dev": "bun --watch ./src/index.ts",
        "lint": "eslint src --ext .ts,.tsx",
        "lint:fix": "eslint src --ext .ts,.tsx --fix",
        "size": "size-limit",
        "test": "bun test",
        "test:coverage": "bun test --coverage",
        "test:watch": "bun test --watch",
        "type-check": "tsc --noEmit",
        "up": "npm publish --access public",
        "up:rc": "npm publish --access public --tag rc"
    },
    "devDependencies": {
        "@size-limit/preset-small-lib": "^11.2.0",
        "@tsconfig/recommended": "^1.0.10",
        "@tsconfig/vite-react": "^3.4.0",
        "@types/bun": "^1.2.20",
        "@types/react": "^19.1.9",
        "@typescript-eslint/eslint-plugin": "^8.39.0",
        "@typescript-eslint/parser": "^8.39.0",
        "eslint": "^9.33.0",
        "eslint-plugin-prettier": "^5.5.4",
        "husky": "^9.1.7",
        "minimatch": "^10.0.3",
        "nodemon": "^3.1.10",
        "prettier": "^3.6.2",
        "size-limit": "^11.2.0",
        "tslib": "^2.8.1",
        "typescript": "~5.0.4",
        "zod": "^4.0.17"
    },
    "peerDependencies": {
        "@form-instant/react-input-mapping": "^1.8.0",
        "react": "^19.1.1",
        "react-dom": "^19.1.1"
    },
    "engines": {
        "node": ">=18",
        "bun": ">=1.0.0"
    },
    "files": [
        "dist"
    ],
    "homepage": "https://leomerida15.github.io/form-instant-react-mapping",
    "husky": {
        "hooks": {
            "pre-commit": "bun run lint"
        }
    },
    "keywords": [
        "@form-instant",
        "react",
        "mapping",
        "zod"
    ],
    "license": "MIT",
    "size-limit": [
        {
            "path": "dist/index.js",
            "limit": "5 KB"
        }
    ]
}
